{
  "name": "photobooth-kiosk-frontend",
  "private": true,
  "type": "module",
  "description": "Self-service kiosk (Framebooth) frontend for photobooth-app-tsl. Builds into ../src/web/frontend/framebooth.html",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:only": "vite build",
    "build:demo": "vue-tsc -b && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check src",
    "format": "eslint . --fix && prettier --write src",
    "gen:api": "openapi-typescript http://127.0.0.1:8000/api/openapi.json -o src/api/schema.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@xstate/vue": "^5.0.1",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "xstate": "^5.32.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
