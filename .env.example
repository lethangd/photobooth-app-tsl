# Copy this file to .env and fill in the values (.env is git-ignored, never commit it).
#   cp .env.example .env        (Windows: copy .env.example .env)
# Values set as real environment variables (Docker, systemd…) take priority over this file.

# ───── Admin page (/admin) ─────
# Password to log in to /admin. Change it before the kiosk goes live (at least 6 characters).
ADMIN_PASSWORD=0000
# 4-digit PIN the staff types on the kiosk to confirm a guest has paid.
STAFF_PIN=1234
# Key signing admin logins. Leave empty: the app generates one on first start and writes it here.
AUTH_TOKEN_SECRET=

# ───── Cloudflare R2: QR download of digital photos (optional) ─────
# Leave empty to disable cloud delivery. Create a bucket + API token in the Cloudflare dashboard → R2.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ───── Automatic confirmation of bank transfers via SePay (optional, https://sepay.vn) ─────
# Link the bank account of the VietQR (set bank_bin / bank_account_number in /admin → Cài đặt) to SePay, then either:
#  - API token (SePay → Cấu hình công ty → API Access): the kiosk polls SePay while a payment is open, no public URL needed
SEPAY_API_TOKEN=
#  - or a webhook to https://<public-address>/api/framebooth/payments/sepay-webhook with "API Key" authentication
SEPAY_WEBHOOK_KEY=
